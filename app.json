{
  "expo": {
    "name": "carrito-uy-app",
    "slug": "carrito-uy-app",
    "scheme": "",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#9fcfb5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tincho8.carrito-uy-app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#9fcfb5"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-barcode-scanner",
      "expo-camera"
    ]
  }
}
